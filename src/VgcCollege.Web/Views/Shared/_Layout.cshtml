<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VGC College</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill me-1"></i>VGC College
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Branches"><i class="bi bi-building me-1"></i>Branches</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Courses"><i class="bi bi-journal-bookmark me-1"></i>Courses</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Students"><i class="bi bi-people me-1"></i>Students</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Enrolments"><i class="bi bi-person-check me-1"></i>Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Faculty"><i class="bi bi-person-workspace me-1"></i>Faculty</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="ManageExams"><i class="bi bi-file-earmark-text me-1"></i>Exams</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Assignments"><i class="bi bi-clipboard me-1"></i>Assignments</a></li>
                    }
                    @if (User.IsInRole("Faculty"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Faculty" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Faculty" asp-action="MyStudents"><i class="bi bi-people me-1"></i>My Students</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Faculty" asp-action="Gradebook"><i class="bi bi-clipboard-data me-1"></i>Gradebook</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Faculty" asp-action="Exams"><i class="bi bi-file-earmark-text me-1"></i>Exam Results</a></li>
                    }
                    @if (User.IsInRole("Student"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="MyCourses"><i class="bi bi-journal-bookmark me-1"></i>My Courses</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Grades"><i class="bi bi-bar-chart me-1"></i>Grades</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="ExamResults"><i class="bi bi-file-earmark-check me-1"></i>Exam Results</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Attendance"><i class="bi bi-calendar-check me-1"></i>Attendance</a></li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

    <footer class="footer mt-5 py-3 bg-light border-top">
        <div class="container text-center text-muted small">
            &copy; @DateTime.Now.Year VGC College — Student Management System
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
