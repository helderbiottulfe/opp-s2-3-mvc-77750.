@model VgcCollege.Web.Models.CourseEnrolment
@{
    ViewData["Title"] = "Enrol Student";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-check me-2"></i>Enrol Student in Course</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateEnrolment" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="StudentProfileId" class="form-label fw-semibold">Student</label>
                        <select asp-for="StudentProfileId" asp-items="ViewBag.Students" class="form-select">
                            <option value="">-- Select Student --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label fw-semibold">Course</label>
                        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                            <option value="">-- Select Course --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EnrolDate" class="form-label fw-semibold"></label>
                        <input asp-for="EnrolDate" class="form-control" type="date" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option>Active</option>
                            <option>Withdrawn</option>
                            <option>Completed</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Enrol</button>
                        <a asp-action="Enrolments" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
