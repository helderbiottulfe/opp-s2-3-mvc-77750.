@model IEnumerable<VgcCollege.Web.Models.StudentProfile>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>Students</h2>
    <a asp-action="CreateStudent" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Student</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Student No.</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>DOB</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><span class="badge bg-primary">@s.StudentNumber</span></td>
                        <td>@s.Name</td>
                        <td>@s.Email</td>
                        <td>@s.Phone</td>
                        <td>@s.DateOfBirth?.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="StudentDetails" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="EditStudent" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
