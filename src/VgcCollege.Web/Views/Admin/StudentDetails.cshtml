@model VgcCollege.Web.Models.StudentProfile
@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-lines-fill me-2"></i>@Model.Name</h2>
    <div class="d-flex gap-2">
        <a asp-action="EditStudent" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Students" class="btn btn-outline-dark">Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <strong>Profile</strong>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Student No:</strong> @Model.StudentNumber</li>
                <li class="list-group-item"><strong>Email:</strong> @Model.Email</li>
                <li class="list-group-item"><strong>Phone:</strong> @Model.Phone</li>
                <li class="list-group-item"><strong>Address:</strong> @Model.Address</li>
                <li class="list-group-item"><strong>DOB:</strong> @Model.DateOfBirth?.ToString("dd MMM yyyy")</li>
            </ul>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white"><strong>Enrolments</strong></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Course</th><th>Enrolled</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Enrolments)
                        {
                            <tr>
                                <td>@e.Course?.Name</td>
                                <td>@e.EnrolDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-@(e.Status == "Active" ? "success" : "secondary")">@e.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white"><strong>Assignment Results</strong></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Assignment</th><th>Course</th><th>Score</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.AssignmentResults)
                        {
                            <tr>
                                <td>@r.Assignment?.Title</td>
                                <td>@r.Assignment?.Course?.Name</td>
                                <td>@r.Score / @r.Assignment?.MaxScore</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark"><strong>Exam Results</strong></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Exam</th><th>Course</th><th>Score</th><th>Grade</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ExamResults)
                        {
                            <tr>
                                <td>@r.Exam?.Title</td>
                                <td>@r.Exam?.Course?.Name</td>
                                <td>@r.Score / @r.Exam?.MaxScore</td>
                                <td>@r.Grade</td>
                                <td>
                                    @if (r.Exam?.ResultsReleased == true)
                                    {
                                        <span class="badge bg-success">Released</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Provisional</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
