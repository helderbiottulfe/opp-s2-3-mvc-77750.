@model IEnumerable<VgcCollege.Web.Models.Exam>
@{
    ViewData["Title"] = "Manage Exams & Results";
}

<h2 class="mb-4"><i class="bi bi-file-earmark-text me-2"></i>Manage Exams & Results</h2>

<div class="mb-3">
    <a asp-action="CreateExam" class="btn btn-danger">
        <i class="bi bi-plus-circle me-1"></i>Create New Exam
    </a>
    <a asp-action="Assignments" class="btn btn-outline-primary ms-2">
        <i class="bi bi-clipboard me-1"></i>Manage Assignments
    </a>
</div>

@foreach (var exam in Model)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@exam.Title</strong>
                <span class="text-muted ms-2 small">| @exam.Course?.Name | @exam.Date.ToString("dd MMM yyyy") | Max: @exam.MaxScore</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (exam.ResultsReleased)
                {
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Released</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-lock me-1"></i>Provisional</span>
                }
                <a asp-action="EditExam" asp-route-id="@exam.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil"></i>
                </a>
                <form asp-action="ToggleExamRelease" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@exam.Id" />
                    <button type="submit" class="btn btn-sm @(exam.ResultsReleased ? "btn-outline-warning" : "btn-outline-success")">
                        @(exam.ResultsReleased ? "Hide Results" : "Release Results")
                    </button>
                </form>
                <a asp-action="AddExamResult" asp-route-examId="@exam.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i>Add Result
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Score</th>
                        <th>%</th>
                        <th>Grade</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!exam.Results.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-2">No results entered yet.</td></tr>
                    }
                    @foreach (var r in exam.Results)
                    {
                        var pct = exam.MaxScore > 0 ? (r.Score / exam.MaxScore * 100) : 0;
                        <tr>
                            <td>@r.StudentProfile?.Name</td>
                            <td>@r.Score / @exam.MaxScore</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:80px">
                                        <div class="progress-bar bg-@(pct>=70?"success":pct>=50?"warning":"danger")"
                                             style="width:@pct%"></div>
                                    </div>
                                    <small>@pct.ToString("0")%</small>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-@(r.Grade=="A"?"success":r.Grade=="B"?"primary":r.Grade=="C"?"warning":"secondary")">
                                    @(r.Grade ?? "—")
                                </span>
                            </td>
                            <td>
                                <a asp-action="EditExamResult" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="alert alert-info mt-2">
    <i class="bi bi-info-circle me-1"></i>
    Students can only view results marked as <strong>Released</strong>. Provisional results are hidden from students.
</div>
