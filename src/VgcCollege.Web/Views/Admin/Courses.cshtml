@model IEnumerable<VgcCollege.Web.Models.Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-bookmark me-2"></i>Courses</h2>
    <a asp-action="CreateCourse" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Course</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Branch</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td><span class="badge bg-secondary">@c.Branch?.Name</span></td>
                        <td>@c.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@c.EndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="EditCourse" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
