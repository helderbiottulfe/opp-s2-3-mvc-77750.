@model IEnumerable<VgcCollege.Web.Models.FacultyProfile>
@{
    ViewData["Title"] = "Faculty";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-workspace me-2"></i>Faculty</h2>
    <a asp-action="AssignFaculty" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Assign Faculty to Course</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Courses</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@f.Email</td>
                        <td>@f.Phone</td>
                        <td>
                            @foreach (var a in f.CourseAssignments)
                            {
                                <span class="badge bg-info text-dark me-1">
                                    @a.Course?.Name @(a.IsTutor ? "(Tutor)" : "")
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
