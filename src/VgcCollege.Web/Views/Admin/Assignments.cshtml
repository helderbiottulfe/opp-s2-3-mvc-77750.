@model IEnumerable<VgcCollege.Web.Models.Assignment>
@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clipboard me-2"></i>Assignments</h2>
    <div class="d-flex gap-2">
        <form method="get" asp-action="Assignments">
            <select name="courseId" asp-items="ViewBag.Courses" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Courses</option>
            </select>
        </form>
        <a asp-action="CreateAssignment" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>New Assignment
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Course</th>
                    <th>Max Score</th>
                    <th>Due Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No assignments found.</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Title</td>
                        <td><span class="badge bg-secondary">@a.Course?.Name</span></td>
                        <td>@a.MaxScore</td>
                        <td>@a.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="EditAssignment" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
