@model IEnumerable<VgcCollege.Web.Models.CourseEnrolment>
@{
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-check me-2"></i>Enrolments</h2>
    <a asp-action="CreateEnrolment" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Enrol Student</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Branch</th>
                    <th>Enrolled</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.StudentProfile?.Name</td>
                        <td>@e.Course?.Name</td>
                        <td>@e.Course?.Branch?.Name</td>
                        <td>@e.EnrolDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge bg-@(e.Status=="Active"?"success":"secondary")">@e.Status</span></td>
                        <td>
                            <form asp-action="DeleteEnrolment" method="post" class="d-inline"
                                  onsubmit="return confirm('Remove this enrolment?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
