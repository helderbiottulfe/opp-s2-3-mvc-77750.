@model VgcCollege.Web.Models.FacultyCourseAssignment
@{
    ViewData["Title"] = "Assign Faculty";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-person-workspace me-2"></i>Assign Faculty to Course</h5>
            </div>
            <div class="card-body">
                <form asp-action="AssignFaculty" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FacultyProfileId" class="form-label fw-semibold">Faculty Member</label>
                        <select asp-for="FacultyProfileId" asp-items="ViewBag.Faculty" class="form-select">
                            <option value="">-- Select Faculty --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label fw-semibold">Course</label>
                        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
                            <option value="">-- Select Course --</option>
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsTutor" class="form-check-input" type="checkbox" />
                        <label asp-for="IsTutor" class="form-check-label">Is Tutor (can view student contact details)</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark">Assign</button>
                        <a asp-action="Faculty" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
