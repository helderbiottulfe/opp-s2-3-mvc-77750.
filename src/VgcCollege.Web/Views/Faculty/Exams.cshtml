@model IEnumerable<VgcCollege.Web.Models.Exam>
@{
    ViewData["Title"] = "Exam Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text me-2"></i>Exam Results</h2>
    <form method="get" asp-action="Exams" class="d-flex gap-2">
        <select name="courseId" asp-items="ViewBag.Courses" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Courses</option>
        </select>
    </form>
</div>

@foreach (var exam in Model)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <div>
                <strong>@exam.Title</strong>
                <span class="text-muted ms-2 small">| @exam.Course?.Name | @exam.Date.ToString("dd MMM yyyy") | Max: @exam.MaxScore</span>
                @if (exam.ResultsReleased)
                {
                    <span class="badge bg-success ms-2">Released</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark ms-2">Provisional</span>
                }
            </div>
            <a asp-action="AddExamResult" asp-route-examId="@exam.Id" class="btn btn-sm btn-outline-success">
                <i class="bi bi-plus-circle me-1"></i>Add / Update Result
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Score</th>
                        <th>%</th>
                        <th>Grade</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!exam.Results.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-2">No results entered yet.</td></tr>
                    }
                    @foreach (var r in exam.Results)
                    {
                        var pct = exam.MaxScore > 0 ? (r.Score / exam.MaxScore * 100) : 0;
                        <tr>
                            <td>@r.StudentProfile?.Name</td>
                            <td>@r.Score / @exam.MaxScore</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:80px">
                                        <div class="progress-bar bg-@(pct>=70?"success":pct>=50?"warning":"danger")"
                                             style="width:@pct%"></div>
                                    </div>
                                    <small>@pct.ToString("0")%</small>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-@(r.Grade=="A"?"success":r.Grade=="B"?"primary":r.Grade=="C"?"warning":"secondary")">
                                    @(r.Grade ?? "—")
                                </span>
                            </td>
                            <td>
                                <a asp-action="EditExamResult" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
