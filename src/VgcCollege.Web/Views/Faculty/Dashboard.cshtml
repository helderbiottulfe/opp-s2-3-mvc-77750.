@{
    ViewData["Title"] = "Faculty Dashboard";
    var profile = ViewBag.Profile as VgcCollege.Web.Models.FacultyProfile;
    var courses = ViewBag.Courses as List<VgcCollege.Web.Models.Course> ?? new();
}

<h2 class="mb-1"><i class="bi bi-person-workspace me-2"></i>Welcome, @profile?.Name</h2>
<p class="text-muted mb-4">Faculty Portal</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-primary text-white text-center p-3">
            <div class="fs-2 fw-bold">@courses.Count</div>
            <div>Assigned Courses</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white text-center p-3">
            <div class="fs-2 fw-bold">@ViewBag.StudentCount</div>
            <div>My Students</div>
        </div>
    </div>
</div>

<h5>My Courses</h5>
<div class="row g-3">
    @foreach (var c in courses)
    {
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">@c.Name</h6>
                    <p class="text-muted small mb-2"><i class="bi bi-building me-1"></i>@c.Branch?.Name</p>
                    <div class="d-flex gap-2">
                        <a asp-action="MyStudents" asp-route-courseId="@c.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-people me-1"></i>Students
                        </a>
                        <a asp-action="Gradebook" asp-route-courseId="@c.Id" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-clipboard-data me-1"></i>Gradebook
                        </a>
                        <a asp-action="Exams" asp-route-courseId="@c.Id" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-file-earmark-text me-1"></i>Exams
                        </a>
                        <a asp-action="Attendance" asp-route-courseId="@c.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-calendar-check me-1"></i>Attendance
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
