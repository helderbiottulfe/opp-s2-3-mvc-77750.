@model IEnumerable<VgcCollege.Web.Models.CourseEnrolment>
@{
    ViewData["Title"] = "Attendance";
    var course = ViewBag.Course as VgcCollege.Web.Models.Course;
}

<h2 class="mb-1"><i class="bi bi-calendar-check me-2"></i>Attendance</h2>
<p class="text-muted mb-4">@course?.Name</p>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-bordered mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    @for (int w = 1; w <= 12; w++)
                    {
                        <th class="text-center">W@w</th>
                    }
                    <th class="text-center">Attended</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model)
                {
                    var attended = enrolment.AttendanceRecords.Count(a => a.Present);
                    var total = enrolment.AttendanceRecords.Count;
                    <tr>
                        <td class="fw-semibold">@enrolment.StudentProfile?.Name</td>
                        @for (int w = 1; w <= 12; w++)
                        {
                            var record = enrolment.AttendanceRecords.FirstOrDefault(a => a.WeekNumber == w);
                            <td class="text-center p-1">
                                <form asp-action="RecordAttendance" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="enrolmentId" value="@enrolment.Id" />
                                    <input type="hidden" name="weekNumber" value="@w" />
                                    @if (record == null)
                                    {
                                        <button type="submit" name="present" value="true"
                                                class="btn btn-sm btn-outline-secondary p-0 px-1" title="Mark Present">–</button>
                                    }
                                    else if (record.Present)
                                    {
                                        <button type="submit" name="present" value="false"
                                                class="btn btn-sm btn-success p-0 px-1" title="Mark Absent">✓</button>
                                    }
                                    else
                                    {
                                        <button type="submit" name="present" value="true"
                                                class="btn btn-sm btn-danger p-0 px-1" title="Mark Present">✗</button>
                                    }
                                </form>
                            </td>
                        }
                        <td class="text-center fw-bold">
                            @attended/@total
                            @if (total > 0)
                            {
                                var pct = attended * 100 / total;
                                <span class="badge bg-@(pct >= 80 ? "success" : pct >= 60 ? "warning" : "danger") ms-1">@pct%</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">Click a cell to toggle attendance. ✓ = Present, ✗ = Absent, – = Not recorded.</p>
