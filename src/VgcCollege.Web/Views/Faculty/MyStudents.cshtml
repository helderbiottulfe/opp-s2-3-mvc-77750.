@model IEnumerable<VgcCollege.Web.Models.CourseEnrolment>
@{
    ViewData["Title"] = "My Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>My Students</h2>
    <div>
        <form method="get" asp-action="MyStudents" class="d-flex gap-2">
            <select name="courseId" asp-items="ViewBag.Courses" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Courses</option>
            </select>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th>Student No.</th>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.StudentProfile?.Name</td>
                        <td>@e.StudentProfile?.StudentNumber</td>
                        <td>@e.Course?.Name</td>
                        <td><span class="badge bg-@(e.Status=="Active"?"success":"secondary")">@e.Status</span></td>
                        <td>
                            <a asp-action="StudentContact" asp-route-id="@e.StudentProfileId"
                               class="btn btn-sm btn-outline-info" title="Contact Details">
                                <i class="bi bi-person-lines-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
