@model IEnumerable<VgcCollege.Web.Models.CourseEnrolment>
@{
    ViewData["Title"] = "My Courses";
}

<h2 class="mb-4"><i class="bi bi-journal-bookmark me-2"></i>My Courses</h2>

@foreach (var e in Model)
{
    var attended = e.AttendanceRecords.Count(a => a.Present);
    var total = e.AttendanceRecords.Count;
    var pct = total > 0 ? attended * 100 / total : 0;

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@e.Course?.Name</strong>
                <span class="badge bg-@(e.Status=="Active"?"success":"secondary") ms-2">@e.Status</span>
            </div>
            <small class="text-muted"><i class="bi bi-building me-1"></i>@e.Course?.Branch?.Name</small>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1 small text-muted">Course Period</p>
                    <p>@e.Course?.StartDate.ToString("dd MMM yyyy") – @e.Course?.EndDate.ToString("dd MMM yyyy")</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-1 small text-muted">Attendance</p>
                    @if (total > 0)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:10px">
                                <div class="progress-bar bg-@(pct>=80?"success":pct>=60?"warning":"danger")"
                                     style="width:@pct%"></div>
                            </div>
                            <small>@attended/@total (@pct%)</small>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">No records yet</span>
                    }
                </div>
            </div>
        </div>
    </div>
}
