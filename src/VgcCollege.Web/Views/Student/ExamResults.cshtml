@model IEnumerable<VgcCollege.Web.Models.ExamResult>
@{
    ViewData["Title"] = "Exam Results";
}

<h2 class="mb-4"><i class="bi bi-file-earmark-check me-2"></i>My Exam Results</h2>

<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>
    Only <strong>released</strong> exam results are shown here. Provisional results will appear once your lecturer publishes them.
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No released exam results available yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Exam</th>
                        <th>Course</th>
                        <th>Date</th>
                        <th>Score</th>
                        <th>Grade</th>
                        <th>%</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var pct = r.Exam?.MaxScore > 0 ? (r.Score / r.Exam!.MaxScore * 100) : 0;
                        <tr>
                            <td>@r.Exam?.Title</td>
                            <td>@r.Exam?.Course?.Name</td>
                            <td>@r.Exam?.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.Score / @r.Exam?.MaxScore</td>
                            <td>
                                <span class="badge fs-6 bg-@(r.Grade=="A"?"success":r.Grade=="B"?"primary":r.Grade=="C"?"warning":"danger")">
                                    @r.Grade
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px; min-width:80px">
                                        <div class="progress-bar bg-@(pct>=70?"success":pct>=50?"warning":"danger")"
                                             style="width:@pct%"></div>
                                    </div>
                                    <small>@pct.ToString("0")%</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
