@model IEnumerable<VgcCollege.Web.Models.CourseEnrolment>
@{
    ViewData["Title"] = "My Attendance";
}

<h2 class="mb-4"><i class="bi bi-calendar-check me-2"></i>My Attendance</h2>

@foreach (var e in Model)
{
    var records = e.AttendanceRecords.OrderBy(a => a.WeekNumber).ToList();
    var attended = records.Count(a => a.Present);
    var total = records.Count;
    var pct = total > 0 ? attended * 100 / total : 0;

    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@e.Course?.Name</strong>
            @if (total > 0)
            {
                <span class="badge bg-@(pct>=80?"success":pct>=60?"warning":"danger") fs-6">
                    @attended/@total sessions (@pct%)
                </span>
            }
        </div>
        <div class="card-body">
            @if (!records.Any())
            {
                <p class="text-muted">No attendance records yet.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var r in records)
                    {
                        <div class="text-center" style="min-width:48px">
                            <div class="badge rounded-pill @(r.Present ? "bg-success" : "bg-danger") p-2">
                                W@r.WeekNumber
                            </div>
                            <div class="small text-muted mt-1">@r.Date.ToString("dd/MM")</div>
                        </div>
                    }
                </div>
                <div class="mt-3">
                    <div class="progress" style="height:12px">
                        <div class="progress-bar bg-@(pct>=80?"success":pct>=60?"warning":"danger")"
                             style="width:@pct%" role="progressbar">@pct%</div>
                    </div>
                </div>
                @if (pct < 80)
                {
                    <div class="alert alert-warning mt-2 py-2 small">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Your attendance is below 80%. Please contact your tutor.
                    </div>
                }
            }
        </div>
    </div>
}
