@model IEnumerable<VgcCollege.Web.Models.AssignmentResult>
@{
    ViewData["Title"] = "My Grades";
}

<h2 class="mb-4"><i class="bi bi-bar-chart me-2"></i>My Assignment Grades</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No assignment results available yet.</div>
}
else
{
    var grouped = Model.GroupBy(r => r.Assignment?.Course?.Name ?? "Unknown");
    foreach (var group in grouped)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <strong><i class="bi bi-journal-bookmark me-1"></i>@group.Key</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Assignment</th>
                            <th>Due Date</th>
                            <th>Score</th>
                            <th>Percentage</th>
                            <th>Feedback</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in group)
                        {
                            var pct = r.Assignment?.MaxScore > 0 ? (r.Score / r.Assignment!.MaxScore * 100) : 0;
                            <tr>
                                <td>@r.Assignment?.Title</td>
                                <td>@r.Assignment?.DueDate.ToString("dd MMM yyyy")</td>
                                <td>@r.Score / @r.Assignment?.MaxScore</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:8px; min-width:80px">
                                            <div class="progress-bar bg-@(pct>=70?"success":pct>=50?"warning":"danger")"
                                                 style="width:@pct%"></div>
                                        </div>
                                        <small class="fw-bold @(pct>=70?"text-success":pct>=50?"text-warning":"text-danger")">
                                            @pct.ToString("0")%
                                        </small>
                                    </div>
                                </td>
                                <td class="text-muted small">@r.Feedback</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
