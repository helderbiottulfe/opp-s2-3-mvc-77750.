@model VgcCollege.Web.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <i class="bi bi-exclamation-triangle-fill display-1 text-danger"></i>
    <h1 class="mt-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Go Home</a>
</div>
