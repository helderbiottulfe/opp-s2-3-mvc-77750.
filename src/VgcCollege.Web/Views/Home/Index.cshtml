@{
    ViewData["Title"] = "Welcome";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <i class="bi bi-mortarboard-fill display-1 text-primary"></i>
        <h1 class="mt-3 fw-bold">Acme Global College</h1>
        <p class="lead text-muted">Multi-Branch Student & Course Management System</p>
        <hr />
        <p class="mb-4">Please log in to access your dashboard.</p>
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-5">
            <i class="bi bi-box-arrow-in-right me-2"></i>Login
        </a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="bi bi-building display-5 text-success"></i>
            <h5 class="mt-2">3 Branches</h5>
            <p class="text-muted small">Dublin, Cork & Galway</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="bi bi-journal-bookmark display-5 text-info"></i>
            <h5 class="mt-2">Multiple Courses</h5>
            <p class="text-muted small">Track enrolments & progress</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <i class="bi bi-shield-check display-5 text-warning"></i>
            <h5 class="mt-2">Role-Based Access</h5>
            <p class="text-muted small">Admin, Faculty & Student portals</p>
        </div>
    </div>
</div>
